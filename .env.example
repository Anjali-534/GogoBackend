PORT=8080
ENVIRONMENT=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=gogoo
DB_PASSWORD=change_me_strong_password
DB_NAME=gogoo
AADHAAR_HASH_PEPPER=change_me_long_random_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — use a long random string in production (min 32 chars)
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars_long

# URLs
DASHBOARD_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Ola Maps (Krutrim) — server-side only, used by GET /gogoo/route to proxy directions
# so the key never reaches panel frontends. Get one at https://maps.olakrutrim.com/
OLA_MAPS_KEY=your_ola_maps_api_key_here

# Google Places API (New) — server-side only, used by GET /gogoo/places/autocomplete
# and /details to proxy address-search for LocationInput.tsx (Dispatch From/Ship To).
# Must be a key with "Places API (New)" enabled in Google Cloud Console. Never set
# with a NEXT_PUBLIC_/EXPO_PUBLIC_ prefix — it must not ship to any frontend bundle.
GOOGLE_PLACES_KEY=your_google_places_api_key_here

# Google Sign-In (POST /auth/google, bogie.in rider login) — must be the same
# OAuth client ID the frontend uses as NEXT_PUBLIC_GOOGLE_CLIENT_ID; this is
# the "audience" idtoken.Validate checks incoming ID tokens against. A
# distinct OAuth client from GOOGLE_PLACES_KEY above (Sign-In vs Places API).
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Cloudinary (required on Railway — leave blank for local disk fallback)
# Sign up free at https://cloudinary.com, then Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email sending (monthly driver earnings statements) goes out via Resend's
# HTTP API, not raw SMTP — Railway blocks outbound SMTP port 587.
# Sign up free at https://resend.com, then API Keys → Create API Key.
RESEND_API_KEY=your_resend_api_key_here

# SMTP_FROM_EMAIL/SMTP_FROM_NAME still set the sender identity shown to
# recipients (Resend needs a "from" address); SMTP_HOST/PORT/USER/PASSWORD
# are unused now and can stay blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=gogoo
